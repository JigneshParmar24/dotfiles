configuration{
    modi: ["drun", "window", "run"];
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    sidebar-mode: false;
    display-drun: " ";
    display-run: " ";
    display-window: " ";
    
    //adding vim keybindings
    kb-row-up: "Up,Control+k";
    kb-row-left: "Left,Control+h";
    kb-row-right: "Right,Control+l";
    kb-row-down: "Down,Control+j";

    kb-accept-entry: "Control+z,Control+y,Return,KP_Enter";

    //fixing up
    kb-remove-to-eol: "";
    kb-move-char-back: "Control+b";
    kb-remove-char-back: "BackSpace";
    kb-move-char-forward: "Control+f";
    kb-mode-complete: "Control+o";
}

@import "colors.rasi"

* {
    font: "FiraCode Nerd Font Mono 13";
    background-color: transparent;
    text-color: @primary;
    border: 0px;
}

window {
    width: 100%;
    height: 100%;
    location: center;
    anchor: center;
    background-color: rgba(0,0,0,0.7);
    border: 0px;
    border-radius: 0px;
    padding: 60px;
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview ];
    background-color: transparent;
}

inputbar {
    padding: 18px 28px;
    margin: 0px 500px 40px 500px;
    background-color: @hv;
    border-radius: 30px;
    children: [ entry ];
}

prompt {
    margin: 0px 8px 0px 0px;
    text-color: @bg;
}

entry {
    text-color: @bg;
    cursor: pointer;
    placeholder: "Search...";
    placeholder-color: @ug;
}

listview {
    layout: vertical;
    padding: 0px;
    lines: 3;
    columns: 7;
    dynamic: false;
    background-color: transparent;
    spacing: 20px;
}

element {
    orientation: vertical;
    padding: 20px 10px;
    background-color: transparent;
    border-radius: 12px;
    cursor: pointer;
}

element selected.normal {
    background-color: rgba(255,255,255,0.1);
}

element-icon {
    size: 4em;
    background-color: transparent;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: @primary;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    margin: 8px 0px 0px 0px;
}