// Inspired by Catnap - JPP Edition
{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

"logo": {
    "source": "~/.config/fastfetch/logos/marcus.txt",
    "type": "auto",
    "width": 1,
    "padding": {
        "top": 0,
        "right": 2,
        "left": 0
    }
},

// "logo": {
//     "source": "~/.config/fastfetch/logos/eva.png",
//     "type": "auto",
//     "width": 35,
//     "padding": {
//         "top": 0,
//         "right": 2,
//         "left": 0
//     }
// },

"display": {
    "separator": " "
},

"modules": [
    {
        "key": "╭───────────╮",
        "type": "custom"
    },

    {
        "key": "│ {#34} user    {#keys}│",
        "type": "title",
        "format": "{user-name}"
    },

    {
        "type": "command",
        "key": "│ {#34}󱦟 age     {#keys}│",
        "text": "printf \"%s days\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
    },

    {
        "key": "│ {#34}󰅐 uptime  {#keys}│",
        "type": "uptime"
    },

    {
        "type": "command",
        "key": "│ {#34} distro  {#keys}│",
        "text": "echo 'Fedora 44'"
    },

    {
        "type": "command",
        "key": "│ {#34} kernel  {#keys}│",
        "text": "uname -r | cut -d'-' -f1"
    },

    {
        "key": "│ {#34} wm      {#keys}│",
        "type": "wm"
    },

    {
        "type": "command",
        "key": "│ {#34}󰍛 cpu     {#keys}│",
        "text": "lscpu | grep 'Model name:' | sed 's/Model name:[ ]*//' | sed 's/AMD //; s/ Processor//; s/(R)//g' | cut -d'@' -f1"
    },

    {
        "type": "command",
        "key": "│ {#34}󰢮 gpu     {#keys}│",
        "text": "nvidia-smi --query-gpu=name --format=csv,noheader | sed 's/NVIDIA GeForce //; s/ Max-Q.*//'"
    },

    {
        "type": "command",
        "key": "│ {#34}󰉉 disk    {#keys}│",
        "text": "df -h / | awk 'NR==2 {print $3 \" / \" $2 \" (\" $5 \")\"}'"
    },

    {
        "key": "│ {#34} memory  {#keys}│",
        "type": "memory"
    },

    {
        "key": "│ {#34} battery {#keys}│",
        "type": "battery"
    },

    {
    "type": "command",
    "key": "│ {#34}󰡨 docker  {#keys}│",
    "text": "systemctl is-active docker >/dev/null && echo 'Running' || echo 'Stopped'"
    },
    {
    "type": "command",
    "key": "│ {#34}󰍹 ws      {#keys}│",
    "text": "hyprctl workspaces -j | jq length"
    },
    {
        "key": "├───────────┤",
        "type": "custom"
    },

    {
        "key": "│ {#34} colors  {#keys}│",
        "type": "colors",
        "symbol": "circle"
    },

    {
        "key": "╰───────────╯",
        "type": "custom"
    }

    // --------------------------------------------------
    // OPTIONAL MODULES
    // Uncomment if you miss them later
    // --------------------------------------------------

    // ,
    // {
    //     "key": "│ {#34}󰇅 hname   {#keys}│",
    //     "type": "title",
    //     "format": "{host-name}"
    // }

    // ,
    // {
    //     "key": "│ {#34}󰇄 desktop {#keys}│",
    //     "type": "de"
    // }

    // ,
    // {
    //     "key": "│ {#34} term    {#keys}│",
    //     "type": "terminal"
    // }

    // ,
    // {
    //     "key": "│ {#34} shell   {#keys}│",
    //     "type": "shell"
    // }

    // ,
    // {
    //     "key": "│ {#34}󰊢 git     {#keys}│",
    //     "type": "command",
    //     "text": "git --version | cut -d' ' -f3"
    // }

    // ,
    // {
    //     "key": "│ {#34}󰏗 pkgs    {#keys}│",
    //     "type": "packages"
    // }
]

}
